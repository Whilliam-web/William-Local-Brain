  "nodes": [
    {"id":"a00000000001","type":"group","x":-1800,"y":-300,"width":5000,"height":1400,"label":"启动月主轴","color":"5"},
    {"id":"a00000000002","type":"group","x":-1800,"y":-1750,"width":2200,"height":1250,"label":"品牌与传播","color":"6"},
